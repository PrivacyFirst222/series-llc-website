# ── Server (Vercel env vars — never commit real values) ──────────────────────
# Every key has a dev fallback, so local development works with none of them set:
# no DATABASE_URL -> embedded local database; no SQUARE_* -> fake checkout;
# no RESEND_API_KEY -> emails logged to console; no BLOB_* -> files in .dev-data/.

# Neon Postgres connection string (Neon dashboard → Connection Details).
# LEAVE THIS UNSET in local dev: the e2e suite writes hundreds of test orders
# per week, and with the production URL here they land in the live database
# (that buried a real customer's order on 2026-08-24). Local dev and e2e run
# on the embedded database; only Vercel's env carries the production URL.
DATABASE_URL=

# Long random string; sign-in cookies are invalidated if it changes
SESSION_SECRET=

# Square (developer.squareup.com → your app). Use sandbox creds + SQUARE_ENV=sandbox
# to test; switch to production creds when going live.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_ENV=sandbox
SQUARE_WEBHOOK_SIGNATURE_KEY=

# Resend (resend.com → API Keys). MAIL_FROM must be on a verified domain.
RESEND_API_KEY=
MAIL_FROM="MyFloridaSeriesLLC <notifications@myfloridaseriesllc.com>"

# Where "new paid order" notifications go
ADMIN_NOTIFY_EMAIL=

# Shared password for /admin
ADMIN_PASSWORD=

# Vercel Blob store token (Vercel dashboard → Storage → Blob)
BLOB_READ_WRITE_TOKEN=

# Smarty (smarty.com → API Keys). The embedded key powers in-browser address
# autocomplete and is restricted to the hostnames registered on it. The auth
# id/token pair powers the server-side USPS-certified (CASS) verification and
# must never reach the browser. All optional — without them addresses are
# plain text fields with no autocomplete and no checks.
VITE_SMARTY_EMBEDDED_KEY=

# Shared secret for the daily cleanup cron (Vercel sends it as
# "Authorization: Bearer <secret>"). Required in production: without it the
# /api/cron/purge route refuses to run, and expired Form 2553 packages would
# only be destroyed when someone opens the portal or the admin dashboard.
CRON_SECRET=
SMARTY_AUTH_ID=
SMARTY_AUTH_TOKEN=

# Public site origin used in emails and Square redirects, e.g. https://myfloridaseriesllc.com
PUBLIC_BASE_URL=
