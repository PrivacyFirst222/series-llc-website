{
  "name": "webapp",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && bun run build:api",
    "build:dev": "vite build --mode development",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:api": "esbuild server/vercel-entry.ts --bundle --platform=node --format=esm --external:@electric-sql/pglite --external:ssh2-sftp-client --loader:.md=text --outfile=api/index.mjs --log-level=warning --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json",
    "test": "bun run src/components/forms/florida-llc/validation.test.ts",
    "e2e": "bun run server/e2e.ts",
    "docs:sync": "bun run ../docs/sync.ts",
    "check": "bun run typecheck && bun run lint && bun run test && bun run e2e && cd .. && python3 docs/provision-map.py && python3 docs/coverage-605.py && python3 docs/event-map.py && python3 docs/docs-consistency.py && python3 docs/structure.py && python3 docs/drafting-lint.py webapp/server/templates-oa-*.md && python3 docs/format-check.py docs/word/*.docx"
  },
